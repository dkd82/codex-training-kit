{
  // Modèle d'équipe pour Kilo Code. Copiez-le à la racine de votre projet sous le nom kilo.jsonc (ou dans .kilo/kilo.jsonc).
  // Organisation et clés vérifiées dans la documentation de Kilo Code (kilo.ai/docs, septembre 2026).
  // Les permissions du projet sont mises en cache : rechargez la fenêtre VS Code (ou démarrez une nouvelle session CLI) après avoir modifié ce fichier.
  "$schema": "https://app.kilo.ai/config.json",

  // Fichiers d'instructions supplémentaires (chemins ou globs), chargés en plus d'AGENTS.md
  "instructions": [".kilo/rules/*.md"],

  "permission": {
    // Les règles sont évaluées dans l'ordre et la DERNIÈRE règle qui correspond l'emporte :
    // mettez la règle générale d'abord et les exceptions après. Puis TESTEZ que vos règles se comportent comme prévu (voir le README).
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      // fichiers qui définissent ce que « correct » veut dire : l'agent ne doit pas les modifier
      "tests/golden/*": "deny"
    },
    "bash": {
      "*": "ask",
      // commandes en lecture seule et de test que vous acceptez de lancer sans confirmation (à adapter à votre projet)
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "python -m pytest *": "allow",
      // jamais sans vous
      "rm *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    // quels sous-agents un agent peut appeler (voir .kilo/agents/)
    "task": {
      "*": "ask",
      "reviewer": "allow",
      "test-writer": "allow"
    }
  }
}
